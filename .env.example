# Copy to .env.local and fill in. Never commit .env.local — it holds real secrets.

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Public/browser-safe key. Newer projects call it the publishable key; older
# ones the anon key — src/lib/env.ts accepts either, publishable takes priority.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App (optional, defaults shown) ----------------------------------------
NEXT_PUBLIC_APP_NAME=لوحة إعلانات الجمعيات
NEXT_PUBLIC_DEFAULT_CURRENCY=SAR

# --- E2E tests (only needed for `npm run test:e2e`) ------------------------
# See tests/e2e/README.md for how to create these users.
PLAYWRIGHT_BASE_URL=http://localhost:3000
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_MEDIA_BUYER_EMAIL=
TEST_MEDIA_BUYER_PASSWORD=
